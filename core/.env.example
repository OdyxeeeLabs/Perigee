# ── Deployment environment ────────────────────────────────────────────────────
# Controls production-safety features such as error redaction.
# Set to "production" in live deployments; any other value (or absent) enables
# verbose error messages for development/staging.
APP_ENV=development

# ── HTTP server ───────────────────────────────────────────────────────────────
SERVER_PORT=8080
RUST_LOG=info
# Emit line-delimited JSON logs for aggregators (e.g. Datadog, Loki).
# Leave unset for human-readable text output.
# LOG_FORMAT=json

# ── Stellar / Soroban RPC ─────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# JSON array of RPC provider objects for the multi-provider pool.
# When set, takes precedence over SOROBAN_RPC_URL.
# RPC_PROVIDERS=[{"name":"stellar-testnet","url":"https://soroban-testnet.stellar.org"}]

# ── Authentication ────────────────────────────────────────────────────────────
# RSA PEM private key for RS256 JWTs. If absent a throwaway dev key is generated.
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
JWT_KEY_RING=
JWT_CURRENT_KEY_ID=
JWT_KEY_OVERLAP_SECS=1800
PERIGEE_ADMIN_STELLAR_ADDRESSES=
EMERGENCY_VERIFICATION_PAUSED=false
AUDIT_LOG_SIGNING_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite://Perigee.db
REDIS_URL=redis://localhost:6379

# ── Fee market ────────────────────────────────────────────────────────────────
FEE_ANALYSIS_ENABLED=false
FEE_COLLECTION_INTERVAL_SECS=5
FEE_RETENTION_DAYS=30

# ── Provider registry ─────────────────────────────────────────────────────────
# REGISTRY_INSTANCE_ID=node-1
# REGISTRY_PUBLIC_URL=https://api.example.com
# REGISTRY_SEED_PEERS=["https://api-b.example.com"]
HEALTH_CHECK_INTERVAL_SECS=30
GOSSIP_INTERVAL_SECS=30

# ── Simulation ────────────────────────────────────────────────────────────────
SIMULATION_TIMEOUT_SECS=30
SIMULATION_MODE=failover
JOB_TIMEOUT_SECS=300
MAX_CONCURRENT_JOBS=10

# ── Persistent cache ──────────────────────────────────────────────────────────
DISK_CACHE_PATH=Perigee_cache
MAX_LEDGER_AGE=100
# =============================================================================
#  Perigee Core API — environment variables template
#  Copy this file to core/.env and fill in the values.
#  .env is git-ignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_PORT=8080
RUST_LOG=info

# -----------------------------------------------------------------------------
# Stellar / Soroban RPC
# -----------------------------------------------------------------------------
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# JSON array of RPC provider objects for multi-provider failover / consensus.
# When empty the engine falls back to SOROBAN_RPC_URL.
# Example:
#   RPC_PROVIDERS=[{"name":"stellar-testnet","url":"https://soroban-testnet.stellar.org"}]
RPC_PROVIDERS=

# -----------------------------------------------------------------------------
# Authentication (JWT / RS256)
# -----------------------------------------------------------------------------
# PEM-encoded RSA private key for signing JWTs.
# Leave unset in local dev — a throwaway dev key is generated automatically.
# In production, set this to a 2048-bit (or stronger) RSA private key.
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# -----------------------------------------------------------------------------
# CORS — white-label partner origins
# Issue #18 / API-15
#
# Comma-separated list of exact origins that are allowed to call this API
# cross-origin.  An "origin" is scheme + host + optional port, e.g.:
#   https://partner-a.example.com
#   https://app.wealth-manager.io:3000
#
# Leave EMPTY (the default) only in local development — an empty value
# enables the wildcard (Any) which lets any web page call the API.
#
# In staging / production this MUST be set to the explicit list of trusted
# white-label frontend domains.  Example:
#   CORS_ALLOWED_ORIGINS=https://partner-a.example.com,https://partner-b.example.com
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite://Perigee.db
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECS=30
DATABASE_POOL_MONITOR_INTERVAL_SECS=15
DATABASE_POOL_ALERT_THRESHOLD_PERCENT=80

# Redis URL reserved for distributed cache (issue #65 — not yet wired in).
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Job queue
# -----------------------------------------------------------------------------
JOB_TIMEOUT_SECS=300
MAX_CONCURRENT_JOBS=10

# -----------------------------------------------------------------------------
# Fee market
# -----------------------------------------------------------------------------
FEE_COLLECTION_INTERVAL_SECS=5
FEE_RETENTION_DAYS=30
FEE_ANALYSIS_ENABLED=true

# -----------------------------------------------------------------------------
# RPC provider registry (gossip)
# -----------------------------------------------------------------------------
REGISTRY_INSTANCE_ID=
REGISTRY_PUBLIC_URL=
REGISTRY_SEED_PEERS=
HEALTH_CHECK_INTERVAL_SECS=30
GOSSIP_INTERVAL_SECS=30

# -----------------------------------------------------------------------------
# Simulation
# -----------------------------------------------------------------------------
SIMULATION_TIMEOUT_SECS=30
# Execution mode: "failover" (default) or "consensus"
SIMULATION_MODE=failover

# Filesystem path for L2 disk cache.  Leave empty to disable (L1-only).
DISK_CACHE_PATH=
MAX_LEDGER_AGE=100
FEATURE_FLAGS=

# -----------------------------------------------------------------------------
# Contract IDs
# (Leave unset; testnet defaults are built in for local/testnet stages.)
# -----------------------------------------------------------------------------
# CONTRACT_POLICY_VAULT=
# CONTRACT_STRATEGY_TRIGGER=
# CONTRACT_FEE_ACCRUAL=
# CONTRACT_EMERGENCY_GUARD=
# CONTRACT_LIQUIDITY_POOL=
# CONTRACT_TOKEN=
# CONTRACT_ORACLE_AGGREGATOR=
# CONTRACT_CROSS_CHAIN_VERIFIER=
# CONTRACT_HELLO_SOROBAN=

{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/consistent-type-imports": [
      "warn",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],
    "no-restricted-globals": [
      "error",
      { "name": "event", "message": "Use local event parameter instead." },
      { "name": "isNaN", "message": "Use Number.isNaN() instead." },
      { "name": "isFinite", "message": "Use Number.isFinite() instead." }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "CallExpression[callee.object.name='process'][callee.property.name='exit']",
        "message": "Do not call process.exit() in browser code."
      }
    ],
    "react/no-danger": "error",
    "react/self-closing-comp": "warn",
    "react-hooks/exhaustive-deps": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.cjs", "**/*.spec.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
